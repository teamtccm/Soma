                                <div class="flex items-center border border-slate-300 rounded-xl bg-white overflow-hidden shadow-sm">
                                    <button onclick="changeDetailQty(-1)" class="w-10 h-10 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition font-bold text-lg">-</button>
                                    <input type="number" id="detail-qty" value="1" min="1" class="w-14 text-center font-bold text-slate-900 border-x border-slate-300 focus:outline-none py-1">
                                    <button onclick="changeDetailQty(1)" class="w-10 h-10 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition font-bold text-lg">+</button>
                                </div>
                            </div>

