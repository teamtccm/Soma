<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOMA - Công Ty TNHH Thương Mại Và Sản Xuất SOMA | Sơn & Chống Thấm Cao Cấp</title>
    <meta name="description" content="SOMA - Giải pháp sơn nội ngoại thất và phụ gia chống thấm chuyên dụng hàng đầu. Công nghệ Nhật Bản bền vững cùng thời gian.">
    
    <!-- Tailwind CSS CDN with Custom Theme Config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        soma: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            200: '#bae0fd',
                            300: '#7cc8fb',
                            400: '#36abf7',
                            500: '#0c8ee9',
                            600: '#006ec7',
                            700: '#0057a1',
                            800: '#044a85',
                            900: '#0a3d6e',
                            950: '#072749',
                        },
                        navy: {
                            800: '#0f2744',
                            900: '#0a192f',
                            950: '#06101e'
                        },
                        slatecustom: {
                            50: '#f8fafc',
                            100: '#f1f5f9',
                            200: '#e2e8f0',
                            300: '#cbd5e1',
                            600: '#475569',
                            800: '#1e293b'
                        }
                    },
                    fontFamily: {
                        sans: ['Be Vietnam Pro', 'Segoe UI', 'sans-serif'],
                        script: ['Dancing Script', 'cursive']
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .font-script {
            font-family: 'Dancing Script', cursive;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .hero-pattern {
            background-color: #082846;
            background-image: radial-gradient(#1e4e79 1.2px, transparent 1.2px), radial-gradient(#1e4e79 1.2px, #082846 1.2px);
            background-size: 48px 48px;
            background-position: 0 0, 24px 24px;
        }
        .testimonial-pattern {
            background-color: #0a3d6e;
            background-image: radial-gradient(#18538c 1px, transparent 1px);
            background-size: 32px 32px;
        }
        @keyframes pulse-slow {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .animate-pulse-slow {
            animation: pulse-slow 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col selection:bg-soma-600 selection:text-white">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-navy-950 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-shield-halved text-soma-400"></i> CÔNG TY TNHH THƯƠNG MẠI VÀ SẢN XUẤT SOMA</span>
                <span class="hidden md:inline text-slate-600">|</span>
                <span class="hidden md:flex items-center gap-1.5"><i class="fa-solid fa-phone text-soma-400"></i> Hotline: <strong class="text-white">0889 166 655</strong></span>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <span class="text-slate-300"><i class="fa-solid fa-truck-fast text-soma-400 mr-1"></i> Giao hàng toàn quốc - Chiết khấu đại lý hấp dẫn</span>
                <span class="hidden sm:inline text-slate-600">|</span>
                <a href="#calculator" onclick="openCalculatorModal()" class="text-soma-300 hover:text-white transition flex items-center gap-1 font-semibold">
                    <i class="fa-solid fa-calculator"></i> Dự toán sơn
                </a>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR (3 Navigation Tabs only as requested: Giới Thiệu, Sản Phẩm, Liên Hệ) -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- SOMA LOGO (Image 9) -->
                <div class="flex items-center gap-3">
                    <a href="javascript:void(0)" onclick="navigateTo('home')" class="flex items-center gap-3 group">
                        <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-200 overflow-hidden shadow-sm flex items-center justify-center p-1 group-hover:scale-105 transition-transform">
                            <img src="images/soma-logo.jpg" alt="SOMA Logo" class="w-full h-full object-contain">
                        </div>
                        <div>
                            <span class="text-2xl font-black tracking-wider text-soma-900 flex items-center gap-1">
                                SOMA<span class="text-soma-500">.</span>
                            </span>
                            <span class="block text-[10px] uppercase font-bold tracking-widest text-slate-500 -mt-1">
                                Sơn & Chống Thấm
                            </span>
                        </div>
                    </a>
                </div>

                <!-- NAVIGATION ITEMS (Exactly 3 Items: Giới Thiệu | Sản Phẩm | Liên Hệ) -->
                <nav class="hidden md:flex items-center gap-8">
                    <a href="javascript:void(0)" onclick="navigateTo('home')" id="nav-home" class="nav-item text-base font-bold text-soma-800 border-b-2 border-soma-700 py-1 transition">
                        Giới thiệu
                    </a>
                    <a href="javascript:void(0)" onclick="navigateTo('products')" id="nav-products" class="nav-item text-base font-semibold text-slate-600 hover:text-soma-700 border-b-2 border-transparent py-1 transition">
                        Sản phẩm
                    </a>
                    <a href="javascript:void(0)" onclick="navigateTo('contact')" id="nav-contact" class="nav-item text-base font-semibold text-slate-600 hover:text-soma-700 border-b-2 border-transparent py-1 transition">
                        Liên hệ
                    </a>
                </nav>

                <!-- HEADER ACTIONS (Search, Phone, Cart) -->
                <div class="flex items-center gap-4">
                    <!-- Search Icon Button -->
                    <button onclick="toggleSearchModal()" class="w-10 h-10 rounded-full text-slate-600 hover:text-soma-700 hover:bg-slate-100 flex items-center justify-center transition" title="Tìm kiếm">
                        <i class="fa-solid fa-magnifying-glass text-lg"></i>
                    </button>
                    
                    <!-- Quick Contact Hotline (Desktop) -->
                    <a href="tel:0889166655" class="hidden lg:flex items-center gap-2.5 bg-slate-100 hover:bg-soma-50 text-soma-900 border border-slate-200 px-3.5 py-1.5 rounded-full text-sm font-semibold transition">
                        <span class="w-6 h-6 rounded-full bg-soma-600 text-white flex items-center justify-center text-xs animate-pulse">
                            <i class="fa-solid fa-phone"></i>
                        </span>
                        <span>0889 166 655</span>
                    </a>

                    <!-- Cart Button with Count Badge -->
                    <button onclick="toggleCartDrawer()" class="relative w-11 h-11 rounded-full bg-soma-50 text-soma-800 hover:bg-soma-100 border border-soma-200 flex items-center justify-center transition shadow-sm" title="Giỏ hàng">
                        <i class="fa-solid fa-cart-shopping text-lg"></i>
                        <span id="cart-badge" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center shadow-md">
                            0
                        </span>
                    </button>

                    <!-- Mobile Menu Hamburger -->
                    <button onclick="toggleMobileMenu()" class="md:hidden w-10 h-10 rounded-lg text-slate-700 hover:bg-slate-100 flex items-center justify-center">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- MOBILE NAVIGATION MENU -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-200 px-4 pt-3 pb-6 space-y-3 shadow-lg">
            <a href="javascript:void(0)" onclick="navigateTo('home'); toggleMobileMenu()" class="block px-3 py-2 rounded-lg text-base font-bold text-soma-800 bg-soma-50">
                <i class="fa-solid fa-house mr-2 text-soma-600"></i> Giới thiệu
            </a>
            <a href="javascript:void(0)" onclick="navigateTo('products'); toggleMobileMenu()" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 hover:bg-slate-50">
                <i class="fa-solid fa-cubes mr-2 text-soma-600"></i> Sản phẩm
            </a>
            <a href="javascript:void(0)" onclick="navigateTo('contact'); toggleMobileMenu()" class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-700 hover:bg-slate-50">
                <i class="fa-solid fa-headset mr-2 text-soma-600"></i> Liên hệ
            </a>
            <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
                <a href="tel:0889166655" class="w-full text-center bg-soma-700 text-white py-2.5 rounded-xl font-bold text-sm shadow">
                    <i class="fa-solid fa-phone mr-1.5"></i> Hotline: 0889 166 655
                </a>
            </div>
        </div>
    </header>

    <!-- ========================================================================= -->
    <!-- VIEW 1: TRANG CHỦ / GIỚI THIỆU (HOME VIEW - Corresponding to Images 1 to 5) -->
    <!-- ========================================================================= -->
    <main id="view-home" class="view-section flex-grow">

        <!-- 1. HERO SECTION (Replaces Image 1 with SOMA Blue theme & Painter Image 10) -->
        <section class="hero-pattern text-white relative overflow-hidden py-12 lg:py-20">
            <!-- Decorative Glow & Shapes -->
            <div class="absolute -top-40 -left-40 w-96 h-96 bg-soma-500/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-soma-400/15 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Left Hero Content -->
                    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-soma-900/80 border border-soma-600/40 text-soma-200 text-sm font-semibold shadow-inner">
                            <i class="fa-solid fa-award text-yellow-400"></i>
                            <span class="font-script text-lg text-yellow-300 tracking-wide mr-1">sơn & chống thấm SOMA</span>
                            • Công nghệ Nhật Bản
                        </div>
                        
                        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
                            Chất lượng nâng tầm <br class="hidden sm:inline">
                            <span class="bg-gradient-to-r from-soma-300 via-sky-200 to-white bg-clip-text text-transparent">
                                mọi công trình bền vững
                            </span>
                        </h1>
                        
                        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                            <strong>SOMA</strong> chuyên sản xuất và phân phối các dòng sơn nội ngoại thất cao cấp, sơn chống thấm chuyên dụng và phụ gia xây dựng. Giải pháp che chở và phục hồi tối ưu cho mọi ngôi nhà Việt.
                        </p>

                        <!-- Highlights list -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs sm:text-sm text-slate-200">
                            <div class="flex items-center gap-2 bg-soma-900/40 border border-soma-700/30 p-2.5 rounded-lg">
                                <i class="fa-solid fa-droplet-slash text-cyan-400 text-base"></i>
                                <span>Chống thấm Nano</span>
                            </div>
                            <div class="flex items-center gap-2 bg-soma-900/40 border border-soma-700/30 p-2.5 rounded-lg">
                                <i class="fa-solid fa-shield-heart text-sky-400 text-base"></i>
                                <span>Bảo hành 10 năm</span>
                            </div>
                            <div class="flex items-center gap-2 bg-soma-900/40 border border-soma-700/30 p-2.5 rounded-lg col-span-2 sm:col-span-1">
                                <i class="fa-solid fa-leaf text-emerald-400 text-base"></i>
                                <span>An toàn thân thiện</span>
                            </div>
                        </div>

                        <!-- CTA Buttons -->
                        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4">
                            <button onclick="navigateTo('products')" class="px-8 py-3.5 rounded-xl bg-soma-500 hover:bg-soma-400 text-white font-bold text-base shadow-lg shadow-soma-600/40 hover:shadow-soma-500/60 hover:-translate-y-0.5 transition flex items-center gap-2.5">
                                <i class="fa-solid fa-cart-shopping"></i>
                                <span>Xem gian hàng</span>
                            </button>
                            <button onclick="navigateTo('contact')" class="px-7 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-base backdrop-blur-sm transition flex items-center gap-2">
                                <i class="fa-solid fa-phone-volume"></i>
                                <span>Liên hệ tư vấn</span>
                            </button>
                        </div>
                    </div>

                    <!-- Right Hero Visual: Kadu-style layout (person on circle + secondary image) -->
                    <div class="lg:col-span-5 flex justify-center relative">
                        <div class="relative w-[340px] h-[420px] sm:w-[420px] sm:h-[500px]">
                            
                            <!-- Main circle backdrop (like Kadu orange circle) -->
                            <div class="absolute bottom-4 right-4 w-[280px] h-[280px] sm:w-[340px] sm:h-[340px] rounded-full bg-gradient-to-br from-soma-400 via-soma-500 to-soma-700 shadow-2xl"></div>
                            <!-- Circle border ring -->
                            <div class="absolute bottom-2 right-2 w-[290px] h-[290px] sm:w-[355px] sm:h-[355px] rounded-full border-2 border-soma-300/30"></div>
                            
                            <!-- Small secondary circular image (waterproofing work) -->
                            <div class="absolute bottom-0 -left-2 sm:left-0 w-[120px] h-[120px] sm:w-[150px] sm:h-[150px] rounded-full overflow-hidden border-4 border-white/20 shadow-xl z-20">
                                <img src="images/waterproof-work.jpg" alt="Chống thấm chuyên nghiệp" class="w-full h-full object-cover">
                            </div>
                            
                            <!-- Painter Image (clean cutout, overlaps circle) -->
                            <div class="relative z-10 w-full h-full flex items-end justify-center">
                                <img src="images/painter-hero.jpg" alt="Thợ sơn SOMA chuyên nghiệp" class="w-[85%] h-auto max-h-[100%] object-contain hover:scale-[1.03] transition-transform duration-500">
                            </div>

                            <!-- Floating badge 1: top right -->
                            <div class="absolute top-8 right-0 z-20 bg-white text-slate-800 px-3.5 py-2 rounded-xl shadow-xl flex items-center gap-2.5 border border-slate-100">
                                <span class="w-8 h-8 rounded-lg bg-soma-100 text-soma-700 flex items-center justify-center font-bold">
                                    <i class="fa-solid fa-check-double"></i>
                                </span>
                                <div>
                                    <div class="text-xs font-bold text-soma-900">Sơn chuẩn 100%</div>
                                    <div class="text-[10px] text-slate-500">Chính hãng SOMA</div>
                                </div>
                            </div>

                            <!-- Floating badge 2: bottom right -->
                            <div class="absolute bottom-14 -right-2 z-20 bg-navy-950/90 text-white backdrop-blur-md px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-2 border border-soma-600/40">
                                <div class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></div>
                                <div class="text-xs font-semibold">Bền bỉ cùng năm tháng</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 2. CATEGORY HIGHLIGHTS BAR (Matching Image 2 Top Section) -->
        <section class="py-12 bg-white border-b border-slate-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-8">
                    <span class="font-script text-xl text-soma-600 font-bold block">Danh mục</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                        Các dòng sản phẩm nổi bật
                    </h2>
                </div>

                <!-- 4 Category Cards matching Image 2 style -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
                    
                    <!-- Cat 1 -->
                    <div onclick="filterProductsCategory('ngoai-that')" class="cursor-pointer group bg-slate-50 hover:bg-soma-50 p-6 rounded-2xl border border-slate-200/80 hover:border-soma-300 transition-all text-center flex flex-col items-center justify-center shadow-sm hover:shadow-md">
                        <div class="w-16 h-16 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-soma-700 text-2xl mb-4 group-hover:scale-110 group-hover:bg-soma-600 group-hover:text-white transition">
                            <i class="fa-solid fa-house-chimney-window"></i>
                        </div>
                        <span class="inline-block px-4 py-1.5 bg-soma-700 text-white rounded-full text-xs sm:text-sm font-bold tracking-wide group-hover:bg-soma-800 transition">
                            Sơn Ngoại Thất
                        </span>
                        <p class="text-xs text-slate-500 mt-2">Chống thấm & kháng tia UV</p>
                    </div>

                    <!-- Cat 2 -->
                    <div onclick="filterProductsCategory('noi-that')" class="cursor-pointer group bg-slate-50 hover:bg-soma-50 p-6 rounded-2xl border border-slate-200/80 hover:border-soma-300 transition-all text-center flex flex-col items-center justify-center shadow-sm hover:shadow-md">
                        <div class="w-16 h-16 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-soma-700 text-2xl mb-4 group-hover:scale-110 group-hover:bg-soma-600 group-hover:text-white transition">
                            <i class="fa-solid fa-paintbrush"></i>
                        </div>
                        <span class="inline-block px-4 py-1.5 bg-soma-700 text-white rounded-full text-xs sm:text-sm font-bold tracking-wide group-hover:bg-soma-800 transition">
                            Sơn Nội Thất
                        </span>
                        <p class="text-xs text-slate-500 mt-2">Lau chùi tối ưu, kháng khuẩn</p>
                    </div>

                    <!-- Cat 3 -->
                    <div onclick="filterProductsCategory('phu-gia')" class="cursor-pointer group bg-slate-50 hover:bg-soma-50 p-6 rounded-2xl border border-slate-200/80 hover:border-soma-300 transition-all text-center flex flex-col items-center justify-center shadow-sm hover:shadow-md">
                        <div class="w-16 h-16 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-soma-700 text-2xl mb-4 group-hover:scale-110 group-hover:bg-soma-600 group-hover:text-white transition">
                            <i class="fa-solid fa-flask-vial"></i>
                        </div>
                        <span class="inline-block px-4 py-1.5 bg-soma-700 text-white rounded-full text-xs sm:text-sm font-bold tracking-wide group-hover:bg-soma-800 transition">
                            Phụ Gia Chống Thấm
                        </span>
                        <p class="text-xs text-slate-500 mt-2">Latex, CT-11A, kết nối vữa</p>
                    </div>

                    <!-- Cat 4 -->
                    <div onclick="filterProductsCategory('chuyen-dung')" class="cursor-pointer group bg-slate-50 hover:bg-soma-50 p-6 rounded-2xl border border-slate-200/80 hover:border-soma-300 transition-all text-center flex flex-col items-center justify-center shadow-sm hover:shadow-md">
                        <div class="w-16 h-16 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-soma-700 text-2xl mb-4 group-hover:scale-110 group-hover:bg-soma-600 group-hover:text-white transition">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <span class="inline-block px-4 py-1.5 bg-soma-700 text-white rounded-full text-xs sm:text-sm font-bold tracking-wide group-hover:bg-soma-800 transition">
                            Chống Thấm Chuyên Dụng
                        </span>
                        <p class="text-xs text-slate-500 mt-2">Màng PU, gốc xi măng, Epoxy</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- 3. ABOUT SECTION (Matching Image 2 Bottom Section) -->
        <section class="py-16 bg-slate-50 border-b border-slate-200 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Left Images with Certified Stamp (Matching Image 2 layout) -->
                    <div class="lg:col-span-6 relative">
                        <div class="relative max-w-md mx-auto">
                            <!-- Main Image (SOMA Paint in Villa Setting) -->
                            <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-200">
                                <img src="images/soma-bucket-1.jpg" alt="Nhà máy và sản phẩm SOMA" class="w-full h-80 sm:h-96 object-cover hover:scale-105 transition-transform duration-500">
                            </div>

                            <!-- Overlapping Secondary Image -->
                            <div class="absolute -bottom-6 -right-6 w-48 sm:w-60 h-36 sm:h-44 rounded-2xl overflow-hidden shadow-xl border-4 border-white bg-white">
                                <img src="images/soma-ext-paint.jpg" alt="Sơn ngoại thất SOMA" class="w-full h-full object-contain p-2 bg-slate-100">
                            </div>

                            <!-- Certified Stamp Badge (Matching Image 2 Stamp) -->
                            <div class="absolute -top-6 -left-6 w-24 h-24 sm:w-28 sm:h-28 rounded-full border-2 border-dashed border-slate-700 bg-white/90 backdrop-blur-sm p-1.5 shadow-lg flex items-center justify-center text-center animate-pulse-slow">
                                <div class="w-full h-full rounded-full border border-slate-700 flex flex-col items-center justify-center p-1 text-slate-900">
                                    <i class="fa-solid fa-stamp text-soma-700 text-lg"></i>
                                    <span class="text-[9px] font-black uppercase tracking-wider mt-0.5">CHỨNG NHẬN</span>
                                    <span class="text-[8px] font-bold text-soma-700">ISO 9001:2015</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Text Content (Exact Text from Image 2) -->
                    <div class="lg:col-span-6 space-y-6">
                        <div>
