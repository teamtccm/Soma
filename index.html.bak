    <div id="calculator-modal" class="fixed inset-0 z-50 overflow-y-auto hidden">
        <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm" onclick="closeCalculatorModal()"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
            <div class="inline-block align-bottom bg-white rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full p-6 sm:p-8">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4 mb-4">
                    <h3 class="text-lg font-black text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-calculator text-soma-600"></i> BẢNG TÍNH LƯỢNG SƠN DỰ TOÁN
                    </h3>
                    <button onclick="closeCalculatorModal()" class="text-slate-400 hover:text-slate-700">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>
                <div class="space-y-4 text-sm">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Diện tích tường cần sơn (m²):</label>
                        <input type="number" id="calc-area" value="100" min="10" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 font-bold text-slate-800 text-base">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Loại công trình:</label>
                        <select id="calc-type" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-slate-800 font-medium">
                            <option value="exterior">Sơn ngoại thất chống thấm (2 lớp lót + 2 lớp phủ)</option>
                            <option value="interior">Sơn nội thất cao cấp (1 lớp lót + 2 lớp phủ)</option>
                            <option value="waterproof">Chống thấm sàn / sàn mái (3 lớp CT-11A)</option>
                        </select>
                    </div>
                    <button onclick="calculatePaint()" class="w-full py-3 rounded-xl bg-soma-800 hover:bg-soma-900 text-white font-bold transition">
                        Tính toán ngay
                    </button>

                    <!-- Result Box -->
                    <div id="calc-result" class="bg-soma-50 p-4 rounded-2xl border border-soma-200 mt-4 space-y-2 text-xs sm:text-sm">
                        <div class="font-bold text-soma-900 border-b border-soma-200 pb-1">Dự toán vật tư ước tính (100 m²):</div>
                        <div class="flex justify-between"><span>Sơn lót kháng kiềm:</span> <strong>~1 Thùng 18L</strong></div>
                        <div class="flex justify-between"><span>Sơn phủ màu chống thấm:</span> <strong>~2 Thùng 18L</strong></div>
                        <div class="flex justify-between"><span>Phụ gia SOMA Latex:</span> <strong>~1 Can 5KG</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

