    <!-- JAVASCRIPT APP LOGIC & DATA -->
    <!-- ========================================================================= -->
    <script>
        // MASTER PRODUCTS DATA
        const products = [
            {
                id: 1,
                name: "Sơn Ngoại Thất Siêu Bóng Chống Thấm SOMA Nano Guard - 18L",
                category: "ngoai-that",
                categoryName: "Sơn ngoại thất",
