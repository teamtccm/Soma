                discount: "-19%",
                image: "images/soma-int-paint.jpg",
                thumbnails: [
                    "images/soma-int-paint.jpg",
                    "images/soma-ext-paint.jpg",
                    "images/soma-bucket-1.jpg",
                    "images/soma-latex.jpg"
                ],
                size: "18 Lít / Thùng",
                coverage: "12 - 14 m²/Lít/Lớp",
                warning: "Bề mặt cần sạch bụi bẩn và khô ráo hoàn toàn trước khi sơn.",
                featured: true,
                rating: 5,
                inStock: true
            },
            {
                id: 3,
                name: "Phụ Gia Chống Thấm & Tác Nhân Kết Nối SOMA Latex - 5KG",
                category: "phu-gia",
                categoryName: "Phụ gia chống thấm",
                code: "SOMA-LATEX-05",
                price: 420000,
                oldPrice: 550000,
                discount: "-24%",
                image: "images/soma-latex.jpg",
                thumbnails: [
                    "images/soma-latex.jpg",
                    "images/soma-ext-paint.jpg",
                    "images/soma-bucket-1.jpg",
                    "images/soma-int-paint.jpg"
                ],
                size: "Can 5 KG",
                coverage: "Trộn tỷ lệ 1L SOMA Latex : 1L Nước : 4KG Xi măng",
                warning: "Trộn đều với nước sạch trước khi cho vào hỗn hợp xi măng cát.",
                featured: true,
                rating: 5,
                inStock: true
            },
            {
                id: 4,
                name: "Sơn Lót Kháng Kiềm Ngoại Thất Cao Cấp SOMA Sealer - 18L",
                category: "ngoai-that",
                categoryName: "Sơn ngoại thất",
                code: "SOMA-SEA-018",
                price: 1450000,
                oldPrice: 1750000,
                discount: "-17%",
                image: "images/soma-ext-paint.jpg",
                thumbnails: [
                    "images/soma-ext-paint.jpg",
                    "images/soma-bucket-1.jpg",
                    "images/soma-int-paint.jpg",
                    "images/soma-latex.jpg"
                ],
                size: "18 Lít / Thùng",
                coverage: "10 - 12 m²/Lít/Lớp",
                warning: "Sơn 1-2 lớp trước khi thi công lớp sơn phủ màu.",
                featured: false,
                rating: 5,
                inStock: true
            },
            {
                id: 5,
                name: "Sơn Nội Thất Siêu Trắng Trần Cao Cấp SOMA White - 18L",
                category: "noi-that",
                categoryName: "Sơn nội thất",
                code: "SOMA-WHT-018",
                price: 980000,
                oldPrice: 1200000,
                discount: "-18%",
                image: "images/soma-int-paint.jpg",
                thumbnails: [
                    "images/soma-int-paint.jpg",
                    "images/soma-ext-paint.jpg",
                    "images/soma-bucket-1.jpg",
                    "images/soma-latex.jpg"
                ],
                size: "18 Lít / Thùng",
                coverage: "12 - 14 m²/Lít/Lớp",
                warning: "Chuyên dụng cho bề mặt trần thạch cao và trần bê tông nội thất.",
                featured: false,
                rating: 5,
                inStock: true
            },
            {
                id: 6,
                name: "Màng Chống Thấm Polyurethane Đa Năng SOMA Proof Ultra - 18L",
                category: "chuyen-dung",
                categoryName: "Chống thấm chuyên dụng",
                code: "SOMA-PU-018",
                price: 2650000,
                oldPrice: 3100000,
                discount: "-15%",
                image: "images/soma-bucket-1.jpg",
                thumbnails: [
                    "images/soma-bucket-1.jpg",
                    "images/soma-ext-paint.jpg",
                    "images/soma-latex.jpg",
                    "images/soma-int-paint.jpg"
                ],
                size: "18 Lít / Thùng",
                coverage: "1.5 - 2.0 kg/m² cho 2 lớp",
                warning: "Dành cho sàn mái lộ thiên, ban công, tầng hầm và bể nước.",
                featured: true,
                rating: 5,
                inStock: true
            }
        ];

        // CART STATE
        let cart = [];
        let currentSelectedProduct = products[0];

        // Format currency helper
        function formatVND(amount) {
            return new Intl.NumberFormat('vi-VN').format(amount) + ' VNĐ';
        }

        // SPA Navigation Manager (Handles 3 pages: home, products, contact + product-detail)
        function navigateTo(viewName, productId = null) {
            // Hide all sections
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));

            // Reset navbar active styles
            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('text-soma-800', 'border-soma-700', 'font-bold');
                el.classList.add('text-slate-600', 'border-transparent', 'font-semibold');
            });

            // Show selected view
            if (viewName === 'home') {
                document.getElementById('view-home').classList.remove('hidden');
                document.getElementById('nav-home')?.classList.add('text-soma-800', 'border-soma-700', 'font-bold');
            } else if (viewName === 'products') {
                document.getElementById('view-products').classList.remove('hidden');
                document.getElementById('nav-products')?.classList.add('text-soma-800', 'border-soma-700', 'font-bold');
                renderCatalog(products);
            } else if (viewName === 'contact') {
                document.getElementById('view-contact').classList.remove('hidden');
                document.getElementById('nav-contact')?.classList.add('text-soma-800', 'border-soma-700', 'font-bold');
            } else if (viewName === 'product-detail') {
                document.getElementById('view-product-detail').classList.remove('hidden');
                document.getElementById('nav-products')?.classList.add('text-soma-800', 'border-soma-700', 'font-bold');
                if (productId) {
                    loadProductDetail(productId);
                }
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Render Home Featured Products
        function renderHomeProducts(items) {
            const container = document.getElementById('home-products-grid');
            if (!container) return;

            container.innerHTML = items.slice(0, 4).map(item => `
                <div class="group bg-white rounded-2xl border border-slate-200 hover:border-soma-300 shadow-sm hover:shadow-xl transition-all overflow-hidden flex flex-col">
                    <div class="relative p-4 bg-slate-50 flex items-center justify-center min-h-[220px] overflow-hidden cursor-pointer" onclick="navigateTo('product-detail', ${item.id})">
                        <span class="absolute top-3 left-3 bg-amber-500 text-white text-[11px] font-black px-2.5 py-0.5 rounded-md shadow-sm z-10">
                            ${item.discount}
                        </span>
                        <span class="absolute top-3 right-3 bg-soma-800 text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm z-10">
                            SOMA
                        </span>
                        <img src="${item.image}" alt="${item.name}" class="h-44 w-auto object-contain group-hover:scale-105 transition-transform duration-300">
                    </div>

                    <div class="p-5 flex flex-col flex-grow justify-between space-y-3">
                        <div>
                            <h3 class="font-bold text-slate-800 text-sm hover:text-soma-700 transition cursor-pointer line-clamp-2" onclick="navigateTo('product-detail', ${item.id})">
                                ${item.name}
                            </h3>
                        </div>

                        <div class="space-y-3">
                            <div class="flex items-baseline justify-between">
                                <span class="text-base font-black text-slate-900">${formatVND(item.price)}</span>
                                <span class="text-xs text-slate-400 line-through">${formatVND(item.oldPrice)}</span>
                            </div>

                            <button onclick="addToCart(${item.id})" class="w-full py-2.5 rounded-xl border border-slate-300 hover:border-soma-700 hover:bg-soma-700 text-slate-700 hover:text-white font-bold text-xs transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-cart-plus"></i>
                                <span>Thêm giỏ hàng</span>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Filter tabs on Home
        function filterHomeProducts(cat, btn) {
            document.querySelectorAll('.home-tab').forEach(b => {
                b.classList.remove('bg-soma-700', 'text-white');
                b.classList.add('bg-slate-100', 'text-slate-700');
            });
            btn.classList.remove('bg-slate-100', 'text-slate-700');
            btn.classList.add('bg-soma-700', 'text-white');

            if (cat === 'all') {
                renderHomeProducts(products);
            } else {
                const filtered = products.filter(p => p.category === cat);
                renderHomeProducts(filtered);
            }
        }

        // Render Catalog Grid (Image 6)
        function renderCatalog(items) {
            const container = document.getElementById('catalog-grid');
            const countEl = document.getElementById('showing-count');
            if (!container) return;

            countEl.innerText = items.length;

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="col-span-3 py-16 text-center text-slate-400 space-y-3">
                        <i class="fa-solid fa-box-open text-5xl"></i>
                        <p class="text-base font-medium">Không tìm thấy sản phẩm phù hợp với bộ lọc.</p>
                        <button onclick="resetAllFilters()" class="text-sm text-soma-700 font-bold underline">Đặt lại bộ lọc</button>
                    </div>
                `;
                return;
            }

            container.innerHTML = items.map(item => `
                <div class="group bg-white rounded-2xl border border-slate-200 hover:border-soma-300 shadow-sm hover:shadow-lg transition-all overflow-hidden flex flex-col">
                    <div class="relative p-4 bg-slate-50 flex items-center justify-center min-h-[220px] cursor-pointer" onclick="navigateTo('product-detail', ${item.id})">
                        <span class="absolute top-3 left-3 bg-amber-500 text-white text-[11px] font-black px-2 py-0.5 rounded shadow-sm z-10">
                            ${item.discount}
                        </span>
                        <span class="absolute top-3 right-3 bg-soma-800 text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-sm z-10">
                            SOMA
                        </span>
                        <img src="${item.image}" alt="${item.name}" class="h-44 w-auto object-contain group-hover:scale-105 transition-transform duration-300">
                    </div>

                    <div class="p-5 flex flex-col flex-grow justify-between space-y-3">
                        <h3 class="font-bold text-slate-800 text-sm hover:text-soma-700 transition cursor-pointer line-clamp-2" onclick="navigateTo('product-detail', ${item.id})">
                            ${item.name}
                        </h3>

                        <div class="space-y-3">
                            <div class="flex items-baseline justify-between">
                                <span class="text-base font-black text-slate-900">${formatVND(item.price)}</span>
                                <span class="text-xs text-slate-400 line-through">${formatVND(item.oldPrice)}</span>
                            </div>

                            <button onclick="addToCart(${item.id})" class="w-full py-2 rounded-xl border border-slate-300 hover:border-soma-700 hover:bg-soma-700 text-slate-700 hover:text-white font-bold text-xs transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-cart-shopping text-xs"></i>
                                <span>Thêm giỏ hàng</span>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Apply Sidebar Filters in Catalog
        let selectedCategory = 'all';
        let activeTag = null;

        function filterCatalogCategory(cat, btn) {
            selectedCategory = cat;
            document.querySelectorAll('.catalog-cat-btn').forEach(b => {
                b.classList.remove('font-bold', 'text-soma-700');
                b.classList.add('text-slate-600');
            });
            btn.classList.add('font-bold', 'text-soma-700');
            btn.classList.remove('text-slate-600');
            applyFilters();
        }

        function filterProductsCategory(cat) {
            navigateTo('products');
            selectedCategory = cat;
            applyFilters();
        }

        function toggleTagFilter(btn, tag) {
            if (activeTag === tag) {
                activeTag = null;
                btn.classList.remove('bg-soma-700', 'text-white');
                btn.classList.add('bg-slate-100', 'text-slate-700');
            } else {
                document.querySelectorAll('.tag-btn').forEach(b => {
                    b.classList.remove('bg-soma-700', 'text-white');
                    b.classList.add('bg-slate-100', 'text-slate-700');
                });
                activeTag = tag;
                btn.classList.remove('bg-slate-100', 'text-slate-700');
                btn.classList.add('bg-soma-700', 'text-white');
            }
            applyFilters();
        }

        function applyFilters() {
            let filtered = [...products];

            // Filter Category
            if (selectedCategory !== 'all') {
                filtered = filtered.filter(p => p.category === selectedCategory);
            }

            // Filter Price
            const checkedPrices = Array.from(document.querySelectorAll('input[name="price-filter"]:checked')).map(cb => cb.value);
            if (checkedPrices.length > 0) {
                filtered = filtered.filter(p => {
                    return checkedPrices.some(val => {
                        if (val === 'under-500k') return p.price < 500000;
                        if (val === '500k-1500k') return p.price >= 500000 && p.price <= 1500000;
                        if (val === 'above-1500k') return p.price > 1500000;
                        return false;
                    });
                });
            }

            // Filter Tags
            if (activeTag === 'featured') {
                filtered = filtered.filter(p => p.featured);
            } else if (activeTag === 'instock') {
                filtered = filtered.filter(p => p.inStock);
            }

            // Sorting
            const sortVal = document.getElementById('sort-select')?.value;
            if (sortVal === 'price-asc') {
                filtered.sort((a, b) => a.price - b.price);
            } else if (sortVal === 'price-desc') {
                filtered.sort((a, b) => b.price - a.price);
            } else if (sortVal === 'name-asc') {
                filtered.sort((a, b) => a.name.localeCompare(b.name));
            }

            renderCatalog(filtered);
        }

        function resetAllFilters() {
            selectedCategory = 'all';
            activeTag = null;
            document.querySelectorAll('input[name="price-filter"]').forEach(cb => cb.checked = false);
            document.querySelectorAll('.tag-btn').forEach(b => {
                b.classList.remove('bg-soma-700', 'text-white');
                b.classList.add('bg-slate-100', 'text-slate-700');
            });
            document.getElementById('sort-select').value = 'default';
            applyFilters();
        }

        // Load Single Product Detail Page (Matching Image 7)
        function loadProductDetail(id) {
            const product = products.find(p => p.id === id) || products[0];
            currentSelectedProduct = product;

            document.getElementById('detail-breadcrumb-cat').innerText = product.categoryName;
            document.getElementById('detail-breadcrumb-name').innerText = product.name;
            document.getElementById('detail-title').innerText = product.name;
            document.getElementById('detail-code').innerText = product.code;
            document.getElementById('detail-price').innerText = formatVND(product.price);
            document.getElementById('detail-old-price').innerText = formatVND(product.oldPrice);
            document.getElementById('detail-discount-badge').innerText = product.discount;
            document.getElementById('detail-main-image').src = product.image;
            document.getElementById('detail-qty').value = 1;
            document.getElementById('spec-size').innerText = product.size;
            document.getElementById('spec-coverage').innerText = product.coverage;
            document.getElementById('spec-warning').innerText = product.warning;

            // Render Thumbnails
            const thumbsContainer = document.getElementById('detail-thumbnails');
            thumbsContainer.innerHTML = product.thumbnails.map((src, idx) => `
                <button onclick="switchDetailImage('${src}', this)" class="detail-thumb-btn rounded-xl border-2 ${idx === 0 ? 'border-soma-700' : 'border-slate-200'} bg-slate-50 p-2 overflow-hidden hover:border-soma-400 transition">
                    <img src="${src}" class="w-full h-14 object-contain">
                </button>
            `).join('');
        }

        function switchDetailImage(src, btn) {
            document.getElementById('detail-main-image').src = src;
            document.querySelectorAll('.detail-thumb-btn').forEach(b => b.classList.replace('border-soma-700', 'border-slate-200'));
            btn.classList.replace('border-slate-200', 'border-soma-700');
        }

        function changeDetailQty(delta) {
            const input = document.getElementById('detail-qty');
            let val = parseInt(input.value) || 1;
            val = Math.max(1, val + delta);
            input.value = val;
        }

        // CART LOGIC
        function addToCart(productId, qty = 1) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existing = cart.find(item => item.id === productId);
            if (existing) {
                existing.qty += qty;
            } else {
                cart.push({ ...product, qty });
            }

            updateCartUI();
            showToast(`Đã thêm "${product.name.slice(0, 30)}..." vào giỏ hàng!`);
        }

        function addToCartFromDetail() {
            const qty = parseInt(document.getElementById('detail-qty').value) || 1;
            addToCart(currentSelectedProduct.id, qty);
        }

        function buyNowFromDetail() {
            addToCartFromDetail();
            toggleCartDrawer();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const container = document.getElementById('cart-items-container');
            const totalEl = document.getElementById('cart-total-price');

            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            badge.innerText = totalCount;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400 space-y-3">
                        <i class="fa-solid fa-cart-shopping text-4xl"></i>
                        <p class="text-sm">Giỏ hàng của bạn đang trống</p>
                    </div>
                `;
                totalEl.innerText = '0 VNĐ';
                return;
            }

            let totalMoney = 0;
            container.innerHTML = cart.map(item => {
                const subtotal = item.price * item.qty;
                totalMoney += subtotal;
                return `
                    <div class="flex items-center gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200">
                        <img src="${item.image}" class="w-14 h-14 object-contain bg-white rounded-lg p-1 border border-slate-200">
                        <div class="flex-grow">
                            <h4 class="text-xs font-bold text-slate-800 line-clamp-1">${item.name}</h4>
                            <div class="text-xs text-soma-800 font-bold mt-0.5">${formatVND(item.price)}</div>
                            <div class="flex items-center gap-2 mt-1">
                                <button onclick="changeCartItemQty(${item.id}, -1)" class="w-5 h-5 bg-white border border-slate-300 rounded flex items-center justify-center text-xs font-bold">-</button>
                                <span class="text-xs font-bold">${item.qty}</span>
                                <button onclick="changeCartItemQty(${item.id}, 1)" class="w-5 h-5 bg-white border border-slate-300 rounded flex items-center justify-center text-xs font-bold">+</button>
                            </div>
                        </div>
                        <button onclick="removeCartItem(${item.id})" class="text-slate-400 hover:text-red-500 p-1">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                `;
            }).join('');

            totalEl.innerText = formatVND(totalMoney);
        }

        function changeCartItemQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (!item) return;
            item.qty += delta;
            if (item.qty <= 0) {
                cart = cart.filter(i => i.id !== id);
            }
            updateCartUI();
        }

        function removeCartItem(id) {
            cart = cart.filter(i => i.id !== id);
            updateCartUI();
        }

        function toggleCartDrawer() {
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.toggle('hidden');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Paint Calculator
        function openCalculatorModal() {
            document.getElementById('calculator-modal').classList.remove('hidden');
        }
        function closeCalculatorModal() {
            document.getElementById('calculator-modal').classList.add('hidden');
        }
        function calculatePaint() {
            const area = parseFloat(document.getElementById('calc-area').value) || 100;
            const type = document.getElementById('calc-type').value;

            let lot = Math.ceil(area / 100);
            let phu = Math.ceil(area / 60);
            let latex = Math.ceil(area / 80);

            document.getElementById('calc-result').innerHTML = `
                <div class="font-bold text-soma-900 border-b border-soma-200 pb-1">Dự toán vật tư cho ${area} m²:</div>
                <div class="flex justify-between"><span>Sơn lót kháng kiềm:</span> <strong>~${lot} Thùng 18L</strong></div>
                <div class="flex justify-between"><span>Sơn phủ màu (${type === 'exterior' ? 'Ngoại thất' : 'Nội thất'}):</span> <strong>~${phu} Thùng 18L</strong></div>
                <div class="flex justify-between"><span>Phụ gia SOMA Latex chống thấm:</span> <strong>~${latex} Can 5KG</strong></div>
                <div class="text-[11px] text-slate-500 mt-2 italic">* Định mức tham khảo thực tế dựa trên bề mặt tường tiêu chuẩn.</div>
            `;
        }

        // Search Modal Mockup
        function toggleSearchModal() {
            const query = prompt('Nhập tên sản phẩm cần tìm kiếm (Ví dụ: Sơn ngoại thất, Latex, Nano):');
            if (query && query.trim()) {
                navigateTo('products');
                const matched = products.filter(p => p.name.toLowerCase().includes(query.toLowerCase()));
                renderCatalog(matched);
            }
        }

        // Checkout Modal Mockup
        function openCheckoutModal() {
            if (cart.length === 0) {
                alert('Giỏ hàng trống! Vui lòng chọn sản phẩm trước.');
                return;
            }
            const phone = prompt('Vui lòng nhập Số điện thoại để SOMA liên hệ giao hàng & báo giá chiết khấu:');
            if (phone) {
                alert(`Cảm ơn bạn! SOMA đã tiếp nhận đơn hàng (${formatVND(cart.reduce((s, i) => s + i.price * i.qty, 0))}). Bộ phận CSKH sẽ gọi tới ${phone} ngay.`);
                cart = [];
                updateCartUI();
                toggleCartDrawer();
            }
        }

        // Contact Form Submission (Image 8)
        function handleContactSubmit(e) {
            e.preventDefault();
            alert('Cảm ơn bạn đã gửi yêu cầu! Ban Giám Đốc và Bộ phận Kỹ thuật Công ty SOMA sẽ liên hệ phản hồi trong thời gian sớm nhất.');
            e.target.reset();
        }

        // Toast feedback
        function showToast(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed top-24 right-6 z-50 bg-soma-900 text-white px-5 py-3 rounded-2xl shadow-2xl border border-soma-500/50 flex items-center gap-2.5 text-sm font-semibold animate-bounce';
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-cyan-400"></i> <span>${msg}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2800);
        }

        // Initial Boot
        document.addEventListener('DOMContentLoaded', () => {
            renderHomeProducts(products);
            renderCatalog(products);
            updateCartUI();
        });
    </script>
</body>
</html>
