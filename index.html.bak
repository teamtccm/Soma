                                    <span class="text-slate-700">Dưới 500.000 VNĐ</span>
                                </label>
                                <label class="flex items-center gap-2.5 cursor-pointer">
                                    <input type="checkbox" name="price-filter" value="500k-1500k" onchange="applyFilters()" class="w-4 h-4 rounded text-soma-700 focus:ring-soma-500 border-slate-300">
                                    <span class="text-slate-700">500.000 - 1.500.000 VNĐ</span>
